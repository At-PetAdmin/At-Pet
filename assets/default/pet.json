    "work": { "row": 4, "frames": 4 },
    "review": { "row": 5, "frames": 4 },
    "error": { "row": 6, "frames": 4 },
    "done": { "row": 7, "frames": 4 },
    "cancelled": { "row": 8, "frames": 4 },
    "tool": { "row": 9, "frames": 4 }
