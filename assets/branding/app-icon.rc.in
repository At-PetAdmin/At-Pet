#include <windows.h>

#define IDI_ICON1 101

IDI_ICON1 ICON "app-icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "At-PetAdmin"
            VALUE "FileDescription", "At-Pet desktop companion"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "at-pet"
            VALUE "LegalCopyright", "Copyright (c) 2026 Ni-ShuWu"
            VALUE "OriginalFilename", "at-pet.exe"
            VALUE "ProductName", "At-Pet"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
